# email.cfg — Email digest configuration for binance-trade-bot
#
# Copy this file to email.cfg and fill in your details.
# email.cfg is git-ignored so your password never ends up in version control.
#
# ── Quick-start for Gmail ────────────────────────────────────────────────────
# 1. Enable 2-Step Verification on your Google account.
# 2. Visit https://myaccount.google.com/apppasswords
# 3. Create an App Password for "Mail" (any device).
# 4. Paste the 16-character code (with or without spaces) as the password below.
# 5. Set enabled=yes, fill in username and recipient, and you're done.
#
# ── Other providers ──────────────────────────────────────────────────────────
# Outlook/Hotmail : host=smtp-mail.outlook.com  port=587
# Yahoo           : host=smtp.mail.yahoo.com    port=587
# Amazon SES      : host=email-smtp.<region>.amazonaws.com  port=587
# Custom SMTP_SSL : set port=465 (skips STARTTLS, uses implicit TLS)
#
# ── Live interval change ─────────────────────────────────────────────────────
# interval_hours can also be changed on-the-fly from the dashboard without
# restarting the bot:  POST /api/email/settings  {"interval_hours": 6}
# Set it to 0 there to pause all sending without editing this file.
# ─────────────────────────────────────────────────────────────────────────────

[email]

# Master switch.  Set to yes to activate.
enabled=no

# SMTP server details.
host=smtp.gmail.com
port=587

# Login credentials.  username is also used as the From address.
username=you@gmail.com
password=xxxx xxxx xxxx xxxx

# Where to deliver the digest.  Multiple recipients are not supported;
# use a distribution list or group alias if you need several addresses.
recipient=you@gmail.com

# How often (in hours) to send the digest.  Common values: 1 or 6.
# Must be > 0.  The dashboard POST /api/email/settings overrides this live.
interval_hours=1
